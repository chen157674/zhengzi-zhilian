# 本地环境、凭据、数据库与任务临时产物
.venv/
.tmp/
.cache/
.tools/
.finesse/
**/__pycache__/
*.py[cod]
node_modules/
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.sqlite*
*.db
*.log
*.maintenance.lock
**/.verification/
# 冻结提交副本单独保留，不把嵌套仓库和压缩包再次纳入开发仓库
/比赛提交/
/预指导提交/
/OPC专项赛/
*.bundle
*.zip
# 大型权重、私人媒体、实验原始数据不进入Git
/data/*
!/data/models/
!/data/fonts/
!/data/knowledge/
!/data/presentation-assets.json
/data/models/**/*.safetensors
/data/models/**/*.bin
/data/models/**/*.pt
/data/models/**/*.pth
/data/models/**/*.onnx
/data/models/**/*.task
/data/knowledge/*
!/data/knowledge/index/
# 保留原历史已有的小型自有编码器
!/data/models/skelgym/world-features.onnx
!/data/models/skelgym/world-transformer.onnx
# 旧轮大批设计图保留在本地；本轮UI与交付材料纳入版本
